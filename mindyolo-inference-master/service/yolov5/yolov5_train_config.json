{
    "component_name": "YOLOv5训练",
    "input": [
        {
            "flag_name": "--data",
            "type": "string",
            "name": "数据集配置文件",
            "description": "设置训练数据集配置文件，包含数据集结构、检测类别和下载信息。",
            "path": ""
        }
    ],
    "output": [
        {
            "flag_name": "--best_weight",
            "type": "string",
            "name": "最优权重",
            "description": "设置模型训练的输出路径，用于存放训练过程中产生的最优权重。",
            "path": "/root/yolov5_train/weights/yolov5_best.pt",
            "is_visiable": false
        }
    ],
    "log": {
        "path": "/root/yolov5_train/log/logout.log"
    },
    "visualization": [
        {
        "data_path": "/root/yolov5_train/runs/train",
        "type": "tensorboard",
        "service_address": ""
        }
    ],
    "config": [
        {
            "flag_name": "--cfg",
            "front_type": "list",
            "front-end-rendering": true,
            "is_required": true,
            "value": ["yolov5s.yaml", "yolov5m.yaml", "yolov5n.yaml", "yolov5l.yaml", "yolov5x.yaml"],
            "data_type": "string",
            "name": "YOLOv5模型配置",
            "default_value": "yolov5s.yaml",
            "description": "选择训练模型配置文件，包括yolov5s.yaml、yolov5m.yaml、yolov5n.yaml、yolov5l.yaml和yolov5x.yaml。"
        },
        {
            "flag_name": "--img",
            "front_type": "input",
            "front-end-rendering": true,
            "is_required": false,
            "value": "",
            "data_type": "int",
            "name": "图像尺寸",
            "default_value": 640,
            "description": "用于YOLOv5模型，图像缩放后的尺寸，默认高和宽均为640。"
        },
        {
            "flag_name": "--epochs",
            "front_type": "input",
            "front-end-rendering": true,
            "is_required": true,
            "value": "",
            "data_type": "int",
            "name": "训练迭代轮数",
            "default_value": 300,
            "description": "设置YOLOv5模型训练迭代轮数，默认为100。"
        },
        {
            "flag_name": "--batch-size",
            "front_type": "input",
            "front-end-rendering": true,
            "is_required": true,
            "value": "",
            "data_type": "int",
            "name": "训练batch-size",
            "default_value": 16,
            "description": "设置一次训练所抓取的数据样本数量，默认为16；调整为-1时，将使用autobatch。"
        },
        {
            "flag_name": "--rect",
            "front_type": "bool",
            "front-end-rendering": true,
            "is_required": false,
            "value": "",
            "data_type": "bool",
            "name": "启用矩阵推理方式训练",
            "default_value": false,
            "description": "矩阵推理会加速模型的推理过程，减少一些冗余信息，默认不开启。"
        },
        {
            "flag_name": "--optimizer",
            "front_type": "list",
            "front-end-rendering": true,
            "is_required": true,
            "value": ["SGD", "Adam", "AdamW"],
            "data_type": "string",
            "name": "训练优化器",
            "default_value": "SGD",
            "description": "设置YOLOv5训练的优化器，默认为SGD。"
        },
        {
            "flag_name": "--workers",
            "front_type": "input",
            "front-end-rendering": true,
            "is_required": false,
            "value": "",
            "data_type": "int",
            "name": "进程数量",
            "default_value": 1,
            "description": "设置进程数量，默认为1。"
        },
        {
            "flag_name": "--save-period",
            "front_type": "input",
            "front-end-rendering": true,
            "is_required": true,
            "value": "",
            "data_type": "int",
            "name": "权重保存频率",
            "default_value": 1,
            "description": "设置权重保存频率，经过几轮epoch，保存一次checkpoint，默认为1。"
        },
        {
            "flag_name": "--patience",
            "front_type": "input",
            "front-end-rendering": true,
            "is_required": false,
            "value": "",
            "data_type": "int",
            "name": "早停epoch数",
            "default_value": 100,
            "description": "设置训练的早停epoch数，若训练几个epoch后，模型效果未提升，就提前停止训练，默认为100。"
        }
    ],
    "run":{
        "command":[
            "python3"
        ],
        "required_args":[
            "train.py"
        ]
    }
}
