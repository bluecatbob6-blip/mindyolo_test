{
    "component_kind": "deepLearning",
    "component_name": "MindYOLO通用训练",
    "input": [
        {
            "flag_name": "--dataset_dir",
            "type": "string",
            "name": "数据集根目录",
            "description": "设置训练数据集根目录位置。",
            "path": ""
        }
    ],
    "output": [
        {
            "flag_name": "--best_weight",
            "type": "string",
            "name": "最优权重",
            "description": "设置模型训练的输出路径，用于存放训练过程中产生的最优权重。",
            "path": "/root/mindyolo_train/weights/mindyolo_best.ckpt",
            "is_visiable": false
        }
    ],
    "log": {
        "flag_name": "--log-path",
        "path": "/root/mindyolo_train/log/logout.log"
    },
    "visualization": {
        "flag_name": "--visual-path",
        "data_path": "/root/mindyolo_train/runs/train",
        "type": "tensorboard",
        "service_address": ""
    },
    "config": [
        {
            "flag_name": "--data",
            "front_type": "input",
            "front-end-rendering": true,
            "is_required": true,
            "value": "",
            "data_type": "string",
            "name": "数据集配置文件",
            "default_value": "/root/mindyolo_train/data/coco128.yaml",
            "description": "设置训练数据集配置文件，包含数据集结构、检测类别和下载信息。",
            "type_of_list": "none"
        },
        {
            "flag_name": "--cfg",
            "front_type": "configFile",
            "front-end-rendering": true,
            "is_required": true,
            "value": "",
            "data_type": "string",
            "name": "模型配置文件",
            "default_value": "/root/mindyolo_train/configs/",
            "description": "上传或指定 MindYOLO 训练用 yaml（与 YOLOv5 平台字段 --cfg 对齐；可为 configs/yolov5/yolov5s.yaml 等）。",
            "type_of_list": "none"
        },
        {
            "flag_name": "--img",
            "front_type": "input",
            "front-end-rendering": true,
            "is_required": false,
            "value": "",
            "data_type": "int",
            "name": "图像尺寸",
            "default_value": 640,
            "description": "训练输入图像边长，默认 640。",
            "type_of_list": "none"
        },
        {
            "flag_name": "--epochs",
            "front_type": "input",
            "front-end-rendering": true,
            "is_required": true,
            "value": "",
            "data_type": "int",
            "name": "训练迭代轮数",
            "default_value": 300,
            "description": "设置模型训练迭代轮数。",
            "type_of_list": "none"
        },
        {
            "flag_name": "--batch-size",
            "front_type": "input",
            "front-end-rendering": true,
            "is_required": true,
            "value": "",
            "data_type": "int",
            "name": "训练batch-size",
            "default_value": 4,
            "description": "单设备 batch 大小（映射为 MindYOLO --per_batch_size）。",
            "type_of_list": "none"
        },
        {
            "flag_name": "--optimizer",
            "front_type": "list",
            "front-end-rendering": true,
            "is_required": true,
            "value": ["SGD", "Adam", "AdamW"],
            "data_type": "string",
            "name": "训练优化器",
            "default_value": "SGD",
            "description": "优化器名称；实际优化器以 MindYOLO yaml 内配置为准，可选透传到子进程。",
            "type_of_list": "single"
        },
        {
            "flag_name": "--workers",
            "front_type": "input",
            "front-end-rendering": true,
            "is_required": false,
            "value": "",
            "data_type": "int",
            "name": "进程数量",
            "default_value": 1,
            "description": "数据加载并行度（透传 MindYOLO 侧若支持）。",
            "type_of_list": "none"
        },
        {
            "flag_name": "--save-period",
            "front_type": "input",
            "front-end-rendering": true,
            "is_required": true,
            "value": "",
            "data_type": "int",
            "name": "权重保存频率",
            "default_value": 1,
            "description": "若干 epoch 保存一次 checkpoint。",
            "type_of_list": "none"
        },
        {
            "flag_name": "--patience",
            "front_type": "input",
            "front-end-rendering": true,
            "is_required": false,
            "value": "",
            "data_type": "int",
            "name": "早停epoch数",
            "default_value": 100,
            "description": "早停耐心轮数（依赖 MindYOLO 训练实现）。",
            "type_of_list": "none"
        }
    ],
    "minio_authorization": {
        "endpoint_flag": "--endpoint",
        "access_key_flag": "--access-key",
        "secret_key_flag": "--secret-key",
        "secure_flag": "--secure"
    },
    "run": {
        "command": [
            "python3"
        ],
        "required_args": [
            "train.py"
        ]
    }
}
